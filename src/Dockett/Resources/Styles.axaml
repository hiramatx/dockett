<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Surface1}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Avalonia 12 adds a full-screen caption button; Dockett doesn't use full screen. -->
  <Style Selector="Button#PART_FullScreenButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Margin" Value="10,12,0,4" />
  </Style>

  <!-- Flat buttons: transparent until hovered. Used by toolbar, tools strip, nav, crumbs, tabs. -->
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LineStrong}" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon PathIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <Style Selector="Button.on /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.accent.danger /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
  </Style>
  <Style Selector="Button.accent.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Navigation pane rows -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="4,0" />
  </Style>
  <Style Selector="Button.nav PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>

  <!-- Tabs -->
  <Style Selector="Border.tab">
    <Setter Property="CornerRadius" Value="6,6,0,0" />
    <Setter Property="Padding" Value="10,0,4,0" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinWidth" Value="70" />
    <Setter Property="MaxWidth" Value="180" />
    <Setter Property="BorderThickness" Value="1,1,1,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Border.tab:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="Border.tab.selected">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
  </Style>
  <Style Selector="Border.tab TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>
  <Style Selector="Border.tab.selected TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
  <Style Selector="Border.tabAccent">
    <Setter Property="Height" Value="2" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Margin" Value="-1,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.pane.active Border.tab.selected Border.tabAccent">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Border.tab Button.tabClose">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.tab:pointerover Button.tabClose, Border.tab.selected Button.tabClose">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- File list -->
  <Style Selector="ListBox.files">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Hover}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftInactive}" />
  </Style>
  <Style Selector="Border.pane.active ListBox.files ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.files ListBoxItem:selected TextBlock.name">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Grid.cut">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="PathIcon.fileIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>
  <Style Selector="PathIcon.fileIcon.folder">
    <Setter Property="Foreground" Value="{DynamicResource FolderBrush}" />
  </Style>

  <!-- Column headers -->
  <Style Selector="Button.header">
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Address bar and search -->
  <Style Selector="Border.field">
    <Setter Property="Background" Value="{DynamicResource Surface2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.crumb">
    <Setter Property="Padding" Value="5,2" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- Splitters: a 1px line with a wider invisible grab area. -->
  <Style Selector="GridSplitter.line">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Width" Value="6" />
    <Setter Property="Margin" Value="-3,0" />
    <Setter Property="ZIndex" Value="10" />
  </Style>

  <!-- Drive usage bars -->
  <Style Selector="ProgressBar.usage">
    <Setter Property="Height" Value="3" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
</Styles>
