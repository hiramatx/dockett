<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dockett.ViewModels"
             xmlns:m="using:Dockett.Models"
             xmlns:v="using:Dockett.Views"
             x:Class="Dockett.Views.FilePaneView"
             x:DataType="vm:PaneViewModel">

  <Border x:Name="Root" Classes="pane" Classes.active="{Binding IsActive}" Background="{DynamicResource Surface2}">
    <DockPanel>
      <!-- Tab strip -->
      <Border DockPanel.Dock="Top" Background="{DynamicResource Surface1}" Padding="6,6,6,0"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <DockPanel Margin="0,0,0,-1">
          <Button DockPanel.Dock="Right" Classes="flat icon" Width="26" Height="26" Margin="4,0,0,3"
                  VerticalAlignment="Bottom" ToolTip.Tip="New tab (Ctrl+T)" Command="{Binding NewTabCommand}">
            <PathIcon Data="{StaticResource Icon.Plus}" Width="13" Height="13" />
          </Button>
          <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TabViewModel">
                  <Border Classes="tab" Classes.selected="{Binding IsSelected}"
                          PointerPressed="OnTabPointerPressed" ToolTip.Tip="{Binding CurrentPath}">
                    <Panel>
                      <Border Classes="tabAccent" />
                      <DockPanel VerticalAlignment="Center">
                        <Button DockPanel.Dock="Right" Classes="flat icon tabClose" Width="20" Height="20" Margin="6,0,0,0"
                                ToolTip.Tip="Close tab (Ctrl+W)"
                                IsVisible="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).CanCloseTabs}"
                                Command="{Binding $parent[ItemsControl].((vm:PaneViewModel)DataContext).CloseTabCommand}"
                                CommandParameter="{Binding}">
                          <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" />
                        </Button>
                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      </DockPanel>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Status line -->
      <Border DockPanel.Dock="Bottom" Padding="10,5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
        <TextBlock Classes="muted" FontSize="12" Text="{Binding SelectedTab.StatusText}" TextTrimming="CharacterEllipsis" />
      </Border>

      <!-- Column headers -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,80,132" Margin="4,2,4,0">
        <Button Grid.Column="0" Classes="flat header" Content="{Binding SelectedTab.NameHeader}"
                Command="{Binding SelectedTab.ToggleSortCommand}" CommandParameter="{x:Static vm:SortColumn.Name}" />
        <Button Grid.Column="1" Classes="flat header" Content="{Binding SelectedTab.SizeHeader}" HorizontalContentAlignment="Right"
                Command="{Binding SelectedTab.ToggleSortCommand}" CommandParameter="{x:Static vm:SortColumn.Size}" />
        <Button Grid.Column="2" Classes="flat header" Content="{Binding SelectedTab.ModifiedHeader}"
                Command="{Binding SelectedTab.ToggleSortCommand}" CommandParameter="{x:Static vm:SortColumn.Modified}" />
      </Grid>

      <!-- Error banner, e.g. access denied -->
      <Border DockPanel.Dock="Top" IsVisible="{Binding SelectedTab.ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource DangerSoft}" CornerRadius="6" Margin="8,4" Padding="10,6">
        <TextBlock Text="{Binding SelectedTab.ErrorText}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
      </Border>

      <Panel>
        <ListBox x:Name="List" Classes="files"
                 ItemsSource="{Binding SelectedTab.Items}"
                 SelectedItem="{Binding SelectedTab.CurrentItem}"
                 SelectionMode="Multiple"
                 IsTextSearchEnabled="True"
                 SelectionChanged="OnSelectionChanged"
                 DoubleTapped="OnDoubleTapped"
                 KeyDown="OnListKeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="m:FileItem">
              <Grid ColumnDefinitions="*,80,132" Background="Transparent">
                <Border Width="3" CornerRadius="2" Margin="-9,4,0,4" HorizontalAlignment="Left"
                        Background="{DynamicResource Warning}" IsVisible="{Binding IsDifferent}"
                        ToolTip.Tip="Missing from or different in the other pane" />
                <DockPanel VerticalAlignment="Center">
                  <PathIcon DockPanel.Dock="Left" Classes="fileIcon" Classes.folder="{Binding IsDirectory}" Margin="0,0,8,0"
                            Data="{Binding Kind, Converter={x:Static v:Converters.FileKindIcon}}" />
                  <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SizeText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                <TextBlock Grid.Column="2" Classes="muted" Text="{Binding ModifiedText}" VerticalAlignment="Center"
                           FontSize="12" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding SelectedTab.IsLoading}" VerticalAlignment="Top"
                     Height="2" MinHeight="2" Background="Transparent" Foreground="{DynamicResource Accent}" />
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
