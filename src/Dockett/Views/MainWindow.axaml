<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dockett.ViewModels"
        xmlns:m="using:Dockett.Models"
        xmlns:v="using:Dockett.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
        x:Class="Dockett.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/dockett.ico"
        Title="Dockett"
        Width="1360" Height="800" MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38">

  <Grid RowDefinitions="38,Auto,*,Auto">

    <!-- Title bar: draggable; the system caption buttons sit over the right end. -->
    <Border Grid.Row="0" chrome:WindowDecorationProperties.ElementRole="TitleBar" Background="{DynamicResource Surface0}">
      <Panel>
        <!-- Sits just left of the system caption buttons; the User role keeps it clickable inside the drag area. -->
        <Button Classes="flat icon" HorizontalAlignment="Right" Margin="0,0,146,0" Width="34" Height="30"
                chrome:WindowDecorationProperties.ElementRole="User"
                ToolTip.Tip="Settings (Ctrl+,)" Command="{Binding OpenSettingsCommand}">
          <PathIcon Data="{StaticResource Icon.Settings}" />
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <Image Source="/Assets/dockett.png" Width="18" Height="18" />
          <TextBlock Text="Dockett" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{Binding ActiveTab.CurrentPath}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" />
        </StackPanel>
      </Panel>
    </Border>

    <!-- Toolbar: history, address bar, search -->
    <Border Grid.Row="1" Background="{DynamicResource Surface0}" Padding="8,2,8,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
          <Button Classes="flat icon" ToolTip.Tip="Back (Alt+Left)" Command="{Binding GoBackCommand}" IsEnabled="{Binding ActiveTab.CanGoBack}">
            <PathIcon Data="{StaticResource Icon.ArrowLeft}" />
          </Button>
          <Button Classes="flat icon" ToolTip.Tip="Forward (Alt+Right)" Command="{Binding GoForwardCommand}" IsEnabled="{Binding ActiveTab.CanGoForward}">
            <PathIcon Data="{StaticResource Icon.ArrowRight}" />
          </Button>
          <Button Classes="flat icon" ToolTip.Tip="Up (Backspace)" Command="{Binding GoUpCommand}" IsEnabled="{Binding ActiveTab.CanGoUp}">
            <PathIcon Data="{StaticResource Icon.ArrowUp}" />
          </Button>
          <Button Classes="flat icon" ToolTip.Tip="Refresh (Ctrl+R)" Command="{Binding RefreshCommand}">
            <PathIcon Data="{StaticResource Icon.Refresh}" />
          </Button>
        </StackPanel>

        <Border DockPanel.Dock="Right" Classes="field" Width="240" Margin="8,0,0,0" BorderBrush="{DynamicResource Line}">
          <DockPanel Margin="8,0,4,0">
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Width="13" Height="13" Foreground="{DynamicResource TextMuted}" />
            <TextBox x:Name="SearchBox" Classes="bare" Text="{Binding ActiveTab.Filter}"
                     PlaceholderText="{Binding ActiveTab.Header, StringFormat='Filter {0}'}" />
          </DockPanel>
        </Border>

        <Border Classes="field">
          <DockPanel Margin="8,0,4,0">
            <PathIcon DockPanel.Dock="Left" Data="{StaticResource Icon.FolderOutline}" Width="14" Height="14" Foreground="{DynamicResource TextMuted}" />
            <Panel>
              <!-- Breadcrumbs; clicking the empty area switches to typing a path -->
              <Panel IsVisible="{Binding !IsEditingAddress}">
                <Button Classes="flat" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Command="{Binding BeginEditAddressCommand}" Cursor="IBeam" />
                <ItemsControl ItemsSource="{Binding ActiveTab.Breadcrumbs}" HorizontalAlignment="Left" Margin="2,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:Crumb">
                      <StackPanel Orientation="Horizontal">
                        <Button Classes="flat crumb" Content="{Binding Name}" ToolTip.Tip="{Binding Path}"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateCrumbCommand}"
                                CommandParameter="{Binding}" />
                        <PathIcon Data="{StaticResource Icon.ChevronRight}" Width="12" Height="12" Foreground="{DynamicResource TextMuted}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Panel>
              <TextBox x:Name="AddressBox" Classes="bare" IsVisible="{Binding IsEditingAddress}" Text="{Binding AddressText}"
                       KeyDown="OnAddressKeyDown" LostFocus="OnAddressLostFocus" />
            </Panel>
          </DockPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- Main area -->
    <Grid x:Name="MainGrid" Grid.Row="2" ColumnDefinitions="200,1,*,1,*,1,260,Auto">

      <!-- Navigation pane -->
      <ScrollViewer Grid.Column="0" Background="{DynamicResource Surface1}">
        <ItemsControl ItemsSource="{Binding NavSections}" Margin="0,0,0,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:NavSection">
              <StackPanel>
                <TextBlock Classes="section" Text="{Binding Title}" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:NavItem">
                      <Button Classes="flat nav" ToolTip.Tip="{Binding Detail}"
                              Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).NavigateToCommand}"
                              CommandParameter="{Binding}">
                        <StackPanel Spacing="4">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <Panel Width="16" Height="16">
                              <Image Source="{Binding ShellIcon}" IsVisible="{Binding HasShellIcon}" Width="16" Height="16"
                                     RenderOptions.BitmapInterpolationMode="HighQuality" />
                              <PathIcon IsVisible="{Binding !HasShellIcon}" Data="{Binding Icon, Converter={x:Static v:Converters.NavIconGeometry}}" />
                            </Panel>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <ProgressBar Classes="usage" IsVisible="{Binding HasUsage}" Value="{Binding UsagePercent}" Margin="24,0,4,2" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Rectangle Grid.Column="1" Fill="{DynamicResource Line}" />
      <GridSplitter Grid.Column="1" Classes="line" ResizeDirection="Columns" />

      <v:FilePaneView x:Name="LeftPane" Grid.Column="2" DataContext="{Binding Left}" />

      <Rectangle Grid.Column="3" Fill="{DynamicResource Line}" />
      <GridSplitter Grid.Column="3" Classes="line" ResizeDirection="Columns" />

      <v:FilePaneView x:Name="RightPane" Grid.Column="4" DataContext="{Binding Right}" />

      <Rectangle x:Name="PreviewLine" Grid.Column="5" Fill="{DynamicResource Line}" />
      <GridSplitter x:Name="PreviewSplitter" Grid.Column="5" Classes="line" ResizeDirection="Columns" />

      <!-- Preview panel -->
      <Border x:Name="PreviewPanel" Grid.Column="6" Background="{DynamicResource Surface2}" Padding="14">
        <Panel>
          <TextBlock Classes="muted" Text="Select a file to preview it" IsVisible="{Binding !Preview.HasItem}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <DockPanel IsVisible="{Binding Preview.HasItem}">
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,12,0,0">
              <TextBlock Text="{Binding Preview.Item.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding Preview.Details}" TextWrapping="Wrap" LineHeight="20" FontSize="12" />
            </StackPanel>
            <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
              <Panel>
                <Image Source="{Binding Preview.Image}" IsVisible="{Binding Preview.ShowImage}" Stretch="Uniform" Margin="8" />
                <ScrollViewer IsVisible="{Binding Preview.ShowText}" HorizontalScrollBarVisibility="Auto">
                  <SelectableTextBlock Text="{Binding Preview.Text}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="10" />
                </ScrollViewer>
                <Image Source="{Binding Preview.LargeIcon}" IsVisible="{Binding Preview.ShowLargeIcon}" Width="64" Height="64"
                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                <PathIcon IsVisible="{Binding Preview.ShowShapeGlyph}" Width="56" Height="56"
                          Classes="fileIcon" Classes.folder="{Binding Preview.Item.IsDirectory}"
                          Data="{Binding Preview.Item.Kind, Converter={x:Static v:Converters.FileKindIcon}}" />
              </Panel>
            </Border>
          </DockPanel>
        </Panel>
      </Border>

      <!-- Tools strip -->
      <Border Grid.Column="7" Width="46" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <DockPanel Margin="0,8">
          <Button DockPanel.Dock="Bottom" Classes="flat icon danger" HorizontalAlignment="Center"
                  ToolTip.Tip="Delete to Recycle Bin (Del)" Command="{Binding DeleteCommand}">
            <PathIcon Data="{StaticResource Icon.Delete}" />
          </Button>
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <Button Classes="flat icon" ToolTip.Tip="Copy to other pane (F5)" Command="{Binding CopyCommand}">
              <PathIcon Data="{StaticResource Icon.Copy}" />
            </Button>
            <Button Classes="flat icon" ToolTip.Tip="Move to other pane (F6)" Command="{Binding MoveCommand}">
              <PathIcon Data="{StaticResource Icon.Move}" />
            </Button>
            <Button Classes="flat icon" ToolTip.Tip="Rename (F2)" Command="{Binding RenameCommand}">
              <PathIcon Data="{StaticResource Icon.Rename}" />
            </Button>
            <Button Classes="flat icon" ToolTip.Tip="New folder (F7)" Command="{Binding NewFolderCommand}">
              <PathIcon Data="{StaticResource Icon.FolderPlus}" />
            </Button>
            <Rectangle Height="1" Width="22" Fill="{DynamicResource Line}" Margin="0,4" />
            <Button Classes="flat icon" ToolTip.Tip="Compress to zip" Command="{Binding CompressCommand}">
              <PathIcon Data="{StaticResource Icon.Archive}" />
            </Button>
            <Button Classes="flat icon" ToolTip.Tip="Compare folders" Command="{Binding CompareCommand}">
              <PathIcon Data="{StaticResource Icon.Compare}" />
            </Button>
            <Button Classes="flat icon" ToolTip.Tip="Properties (Alt+Enter)" Command="{Binding PropertiesCommand}">
              <PathIcon Data="{StaticResource Icon.Info}" />
            </Button>
            <Button Classes="flat icon" Classes.on="{Binding IsPreviewVisible}" ToolTip.Tip="Preview panel (F3)"
                    Command="{Binding TogglePreviewCommand}">
              <PathIcon Data="{StaticResource Icon.PreviewPanel}" />
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Shortcut hints and last result -->
    <Border Grid.Row="3" Background="{DynamicResource Surface0}" Padding="12,5" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" Classes="secondary" FontSize="12" Text="{Binding StatusMessage}" />
        <StackPanel Orientation="Horizontal" Spacing="18">
          <StackPanel.Styles>
            <Style Selector="TextBlock">
              <Setter Property="FontSize" Value="12" />
              <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            </Style>
          </StackPanel.Styles>
          <TextBlock Text="F2 Rename" />
          <TextBlock Text="F3 Preview" />
          <TextBlock Text="F5 Copy" />
          <TextBlock Text="F6 Move" />
          <TextBlock Text="F7 New folder" />
          <TextBlock Text="Del Delete" />
          <TextBlock Text="Ctrl+T New tab" />
          <TextBlock Text="Tab Switch pane" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
